<Project>

  <!--
    Uno ingest: rewrites upstream's UWP-flavoured C# into the Microsoft.UI.* form Uno
    compiles, writing the result to $(UnoIngestOutputPath). Upstream files are never
    modified - that invariant is what makes `git merge msft/main` conflict-free, and it
    is enforced by uno/ci/purity-gate.sh.

    Every rule below is either a genuine UWP -> WinUI API difference (upstream's sources
    would not compile against WinUI either), or a workaround for a filed Uno bug. The
    Uno-bug rules carry their issue number and are deleted as fixes land.

    Implemented as an inline task so it needs nothing beyond the .NET SDK.
  -->

  <UsingTask TaskName="UnoIngest" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <UpstreamRoot ParameterType="System.String" Required="true" />
      <UpstreamXamlDir ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <RewrittenCount ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[

// ---- ordered, longest-match-first -------------------------------------------------
var rules = new List<KeyValuePair<string, string>>();
Action<string, string> R = (a, b) => rules.Add(new KeyValuePair<string, string>(a, b));

// Namespace moves. Deny case: Windows.UI.Color (singular) stays under Windows.*,
// while Windows.UI.Colors (plural) moves - handled by the sentinel below.
R("Windows.UI.Xaml",        "Microsoft.UI.Xaml");
R("Windows.UI.Text",        "Microsoft.UI.Text");
R("Windows.UI.Composition", "Microsoft.UI.Composition");
R("Windows.UI.Colors",      "Microsoft.UI.Colors");

// UWP -> WinUI type moves (not Uno gaps).
R("Windows.Devices.Input.PointerDeviceType",   "Microsoft.UI.Input.PointerDeviceType");
R("Windows.UI.Core.WindowSizeChangedEventArgs","Microsoft.UI.Xaml.WindowSizeChangedEventArgs");
R("Windows.UI.Core.CoreWindowActivationState", "Microsoft.UI.Xaml.WindowActivationState");
R("CoreWindowActivationState",                 "Microsoft.UI.Xaml.WindowActivationState");
R("== PointerDeviceType.",                     "== Microsoft.UI.Input.PointerDeviceType.");

// WinUI moves the UWP activation payload behind UWPLaunchActivatedEventArgs.
R("args.PrelaunchActivated",           "args.UWPLaunchActivatedEventArgs.PrelaunchActivated");
R("OnAppLaunch(args, args.Arguments,", "OnAppLaunch(args.UWPLaunchActivatedEventArgs, args.Arguments,");
// WinUI 3 has no Application.OnActivated; protocol activation arrives via AppInstance instead.
R("protected override void OnActivated(IActivatedEventArgs args)", "private void OnActivated(IActivatedEventArgs args)");
// WinUI 3 has no Application.Suspending; CoreApplication raises it instead.
R("            Suspending += OnSuspending;", "            global::Windows.ApplicationModel.Core.CoreApplication.Suspending += OnSuspending;");
R("Application.Current.Suspending += ", "global::Windows.ApplicationModel.Core.CoreApplication.Suspending += ");

// WinUI 3 removed CoreWindow, so keyboard shortcuts are rehosted on the root visual by
// uno/adapters/KeyboardBridge.cs. Only the handler parameter types change; bodies are upstream's.
R("                var coreWindow = Window.Current.CoreWindow;\n" +
  "                coreWindow.CharacterReceived += OnCharacterReceivedHandler;\n" +
  "                coreWindow.KeyDown += OnKeyDownHandler;\n" +
  "                coreWindow.KeyUp += OnKeyUpHandler;\n" +
  "                coreWindow.Dispatcher.AcceleratorKeyActivated += OnAcceleratorKeyActivated;",
  "                global::CalculatorApp.Uno.KeyboardBridge.Attach(OnCharacterReceivedHandler, OnKeyDownHandler, OnKeyUpHandler, OnAcceleratorKeyActivated);");
R("OnCharacterReceivedHandler(CoreWindow sender, CharacterReceivedEventArgs args)",
  "OnCharacterReceivedHandler(object sender, global::CalculatorApp.Uno.CoreCharacterArgs args)");
R("OnKeyDownHandler(CoreWindow sender, KeyEventArgs args)",
  "OnKeyDownHandler(object sender, global::CalculatorApp.Uno.CoreKeyArgs args)");
R("OnKeyUpHandler(CoreWindow sender, KeyEventArgs args)",
  "OnKeyUpHandler(object sender, global::CalculatorApp.Uno.CoreKeyArgs args)");
R("OnAcceleratorKeyActivated(CoreDispatcher dispatcher, AcceleratorKeyEventArgs args)",
  "OnAcceleratorKeyActivated(object dispatcher, global::CalculatorApp.Uno.CoreAcceleratorArgs args)");
R("Window.Current.CoreWindow.GetKeyState(", "global::Microsoft.UI.Input.InputKeyboardSource.GetKeyStateForCurrentThread(");

// --- Uno workarounds. Every rule below cites a filed issue and is deleted when that
// --- fix ships. See uno/docs/WORKAROUNDS.md for the index. ------------------------

// unoplatform/uno#24298 - unimplemented members that throw on the startup path.
R("var appView = ApplicationView.GetForCurrentView();",
  "/* Uno Workaround #24298: ApplicationView.GetForCurrentView not implemented */");
R("appView.SetPreferredMinSize(minWindowSize);",
  "/* Uno Workaround #24298: ApplicationView.SetPreferredMinSize not implemented */");
R("appView.TryResizeView(minWindowSize);",
  "/* Uno Workaround #24298: ApplicationView.TryResizeView not implemented */");
R("ApplicationView.PreferredLaunchWindowingMode = ApplicationViewWindowingMode.Auto;",
  "/* Uno Workaround #24298: ApplicationView.PreferredLaunchWindowingMode not implemented */");
R("SizeHelper.FromDimensions(", "new global::Windows.Foundation.Size(");
R("NavCategoryStates.SetCurrentUser(args.User.NonRoamableId);",
  "NavCategoryStates.SetCurrentUser(string.Empty); // Uno Workaround #24298: LaunchActivatedEventArgs.User not implemented");
R("UserActivityRequestManager.GetForCurrentView().UserActivityRequested += async (_, args) =>",
  "var __unoUserActivityHandler = /* Uno Workaround #24298: UserActivityRequestManager not implemented */ " +
  "async (global::System.Object _, global::Windows.ApplicationModel.UserActivities.UserActivityRequestedEventArgs args) =>");
R("                string formatted = formatter.FormatUInt(i);\n" +
  "                _digitSymbols[i] = formatted[0];",
  "                _digitSymbols[i] = (char)('0' + i); /* Uno Workaround #24298: DecimalFormatter.FormatUInt not implemented */");

// Uno Workaround (unfiled: popup-child-x-load) - the forked MainPage.xaml drops x:Load from
// PopupContent, so it is never null here; size it on every open instead of only on first load.
R("            if (PopupContent == null)\n" +
  "            {\n" +
  "                FindName(\"PopupContent\");\n" +
  "\n" +
  "                var windowBounds",
  "            {\n" +
  "                var windowBounds");

// Uno Workaround (unfiled: itemsstackpanel-in-itemscontrol) - see uno/adapters/ItemsPanelCompat.cs.
R("                    m_itemsControl = (ItemsControl)uiElement;\n",
  "                    m_itemsControl = (ItemsControl)uiElement;\n" +
  "                    global::CalculatorApp.Uno.ItemsPanelCompat.UseHorizontalStackPanel(m_itemsControl);\n");

// Uno Workaround (unfiled: pivot-items-mutation) - see uno/adapters/PivotCompat.cs.
R("                m_pivotItem = (PivotItem)DockPivot.Items[0];\n",
  "                global::CalculatorApp.Uno.PivotCompat.PrepareForItemsChange(DockPivot);\n" +
  "                m_pivotItem = (PivotItem)DockPivot.Items[0];\n");
R("                    DockPivot.Items.Insert(0, m_pivotItem);\n",
  "                    global::CalculatorApp.Uno.PivotCompat.PrepareForItemsChange(DockPivot);\n" +
  "                    DockPivot.Items.Insert(0, m_pivotItem);\n");
R("            DockPivot.SelectedIndex = 0;\n" +
  "            UpdateViewState();\n" +
  "            UpdatePanelViewState();\n" +
  "        }\n\n" +
  "        private void OnIsStandardPropertyChanged",
  "            DockPivot.SelectedIndex = 0;\n" +
  "            global::CalculatorApp.Uno.PivotCompat.RefreshHeaders(DockPivot);\n" +
  "            UpdateViewState();\n" +
  "            UpdatePanelViewState();\n" +
  "        }\n\n" +
  "        private void OnIsStandardPropertyChanged");

// Uno Workaround (unfiled: templateselector-null-item) - Uno asks the selector for a template while the
// container's Content is still null; the NRE aborts every supplementary result ("About equal to" stayed empty).
R("            SupplementaryResult result = (SupplementaryResult)item;\n" +
  "            if (result.IsWhimsical())",
  "            SupplementaryResult result = item as SupplementaryResult;\n" +
  "            if (result?.IsWhimsical() == true)");

// Uno Workaround (unfiled: clipboard-setcontentwithoptions) - not implemented, so Ctrl+C copied nothing.
// With null options it is SetContent.
R("Clipboard.SetContentWithOptions(dataPackage, null);", "Clipboard.SetContent(dataPackage);");
// Same for paste: only the parameterless GetTextAsync is implemented, and it reads the Text format.
R("dataPackageView.GetTextAsync(StandardDataFormats.Text)", "dataPackageView.GetTextAsync()");

// Uno Workaround (unfiled: xbind-theme-source) - an x:Bind to AboutEULA.Foreground is not notified when a theme
// switch re-resolves that brush, so the GitHub link kept the old theme's colour. Re-run the bindings once it settles.
R("                ThemeHelper.RootTheme = ThemeHelper.GetEnum<ElementTheme>(selectItem.Tag.ToString());\n",
  "                ThemeHelper.RootTheme = ThemeHelper.GetEnum<ElementTheme>(selectItem.Tag.ToString());\n" +
  "                DispatcherQueue.TryEnqueue(Microsoft.UI.Dispatching.DispatcherQueuePriority.Low, () => Bindings.Update());\n");

// WinUI 3 has no ApplicationView compact overlay (and Uno throws on it, #24298): "Keep on top" goes through
// AppWindow instead - see uno/adapters/AlwaysOnTopCompat.cs.
R("ApplicationView.GetForCurrentView().IsViewModeSupported(ApplicationViewMode.CompactOverlay)",
  "global::CalculatorApp.Uno.AlwaysOnTopCompat.IsSupported");
R("ApplicationView.GetForCurrentView().ViewMode == ApplicationViewMode.CompactOverlay",
  "global::CalculatorApp.Uno.AlwaysOnTopCompat.IsActive");
R("ViewModePreferences.CreateDefault(ApplicationViewMode.CompactOverlay)",
  "global::CalculatorApp.Uno.AlwaysOnTopCompat.CreateOptions()");
R("ApplicationView.GetForCurrentView().TryEnterViewModeAsync(ApplicationViewMode.Default)",
  "global::CalculatorApp.Uno.AlwaysOnTopCompat.Exit()");
R("ApplicationView.GetForCurrentView().TryEnterViewModeAsync(ApplicationViewMode.CompactOverlay, compactOptions)",
  "global::CalculatorApp.Uno.AlwaysOnTopCompat.Enter(compactOptions.CustomSize)");

// unoplatform/uno#24288 - GetApplicationViewIdForWindow throws instead of a sentinel.
R("ApplicationView.GetApplicationViewIdForWindow(CoreWindow.GetForCurrentThread())",
  "-1 /* Uno Workaround #24288 */");
R("windowId = ApplicationView.GetApplicationViewIdForWindow(window);",
  "/* Uno Workaround #24288: throws instead of returning a sentinel; -1 is the documented value. */");

// unoplatform/uno#24296 - multi-arg formatter ctors leave internals null, so every
// later member access NREs far from the cause.
R("new DecimalFormatter(new[] { _resolvedName }, \"ZZ\")",
  "new DecimalFormatter() /* Uno Workaround #24296: 2-arg ctor leaves internals null */");
// ...and the date calculator's 5-arg one, whose language argument (Language.CurrentInputMethodLanguageTag) throws
// NotImplementedException on its own (unfiled: input-method-language-tag), failing DateCalculatorViewModel's ctor.
R("            _dateTimeFormatter = new Windows.Globalization.DateTimeFormatting.DateTimeFormatter(\n" +
  "                \"longdate\",\n" +
  "                new[] { Windows.Globalization.Language.CurrentInputMethodLanguageTag },\n" +
  "                new Windows.Globalization.GeographicRegion().CodeTwoLetter ?? \"US\",\n" +
  "                calendarIdentifier,\n" +
  "                Windows.Globalization.ClockIdentifiers.TwentyFourHour);",
  "            _dateTimeFormatter = new Windows.Globalization.DateTimeFormatting.DateTimeFormatter(\"longdate\"); // Uno Workaround #24296");
R("new DateTimeFormatter(format, new[] { _resolvedName }, \"ZZ\", calendar, clock)",
  "new DateTimeFormatter(format) /* Uno Workaround #24296: multi-arg ctor unimplemented */");

// Uno Workaround #24284 - resolve MRT slash-paths against the raw resw names; see uno/adapters/MrtCompat.cs.
R("_stringResLoader?.GetString(key)", "global::CalculatorApp.Uno.MrtCompat.GetString(_stringResLoader, key)");
// No global:: here - these calls sit inside interpolated strings, where "::" parses as a format specifier.
R("loader.GetString(\"", "CalculatorApp.Uno.MrtCompat.GetString(loader, \"");

// Uno Workaround #24284 - MRT slash-path lookups return "", and this markup extension
// Enum.Parse()s the result, throwing during XAML load.
R("return Enum.Parse(typeof(MyVirtualKey), resourceString);",
  "return string.IsNullOrEmpty(resourceString) ? (object)default(MyVirtualKey) : Enum.Parse(typeof(MyVirtualKey), resourceString);");
R("LocalizationSettings.GetInstance().GetFlowDirection()",
  "global::Microsoft.UI.Xaml.FlowDirection.LeftToRight /* Uno Workaround #24284: LocalizationSettings init */");

// Uno Workaround #24391 - the converter's value containers are HorizontalAlignment=Left,
// and under Uno that collapses the grid to its content width: the CalculationResult's inner
// ScrollViewer ends up exactly as wide as the text (8.7px for "0"), so the control's font
// auto-scaler sees "text already fills the container", shrinks to MinFontSize and can never
// grow. WinUI renders the same markup at MaxFontSize. Stretching just the two value containers
// restores it (measured: 36.7px/font 14 -> 500.7px/font 46); the ComboBoxes that share this
// binding must stay Left, so this cannot be fixed on FlowDirectionHorizontalAlignment itself.
R("            InitializeComponent();\n" +
  "\n" +
  "            // adding ESC key shortcut binding to clear button",
  "            InitializeComponent();\n" +
  "\n" +
  "            // Uno Workaround #24391: content-width collapse starves the font auto-scaler.\n" +
  "            // Applied on Loaded: the x:Bind on HorizontalAlignment re-asserts Left after the ctor.\n" +
  "            Loaded += (_, __) =>\n" +
  "            {\n" +
  "                Value1Container.HorizontalAlignment = HorizontalAlignment.Stretch;\n" +
  "                Value2Container.HorizontalAlignment = HorizontalAlignment.Stretch;\n" +
  "            };\n" +
  "\n" +
  "            // adding ESC key shortcut binding to clear button");

// Uno Workaround #24390 - GeographicRegion.CodeTwoLetter throws NotImplementedException, so
// every converter page and the date calculator fail to construct their ViewModel. Upstream's
// `?? "US"` guard cannot help: the getter throws instead of returning null.
R("            : this(region?.CodeTwoLetter ?? \"US\")",
  "            : this(global::CalculatorApp.Uno.GlobalizationCompat.CurrentRegionCode) // Uno Workaround #24390");

R("                new Windows.Globalization.GeographicRegion().CodeTwoLetter ?? \"US\",",
  "                global::CalculatorApp.Uno.GlobalizationCompat.CurrentRegionCode, // Uno Workaround #24390");

R("            string userCurrency = Windows.System.UserProfile.GlobalizationPreferences.Currencies.Count > 0\n" +
  "                ? Windows.System.UserProfile.GlobalizationPreferences.Currencies[0]\n" +
  "                : \"USD\";",
  "            string userCurrency = global::CalculatorApp.Uno.GlobalizationCompat.CurrentCurrencyCode; // Uno Workaround #24390");

R("                var languages = Windows.System.UserProfile.GlobalizationPreferences.Languages;",
  "                var languages = global::CalculatorApp.Uno.GlobalizationCompat.CurrentLanguages; // Uno Workaround #24390");

// Upstream portability, not an Uno bug: these four imports resolve only on Windows, so
// MainPage's constructor throws DllNotFoundException("kernel32.dll") on wasm, Android, iOS,
// Linux and macOS. uno/adapters/Win32Locale.cs reimplements them over CultureInfo with the
// same return-value contracts. Delete if microsoft/calculator ever drops the P/Invokes.
const string k32 = "        [DllImport(\"kernel32.dll\", CharSet = CharSet.Unicode, SetLastError = true)]\n";
const string shimNote = "        // Upstream Workaround: kernel32 is Windows-only; see uno/adapters/Win32Locale.cs\n";

R(k32 + "        private static extern int ResolveLocaleName(string lpNameToResolve, [Out] char[] lpLocaleName, int cchLocaleName);",
  shimNote +
  "        private static int ResolveLocaleName(string lpNameToResolve, char[] lpLocaleName, int cchLocaleName)\n" +
  "            => global::CalculatorApp.Uno.Win32Locale.ResolveLocaleName(lpNameToResolve, lpLocaleName, cchLocaleName);");

R(k32 + "        private static extern int GetLocaleInfoEx(string lpLocaleName, uint LCType, [Out] char[] lpLCData, int cchData);",
  "        private static int GetLocaleInfoEx(string lpLocaleName, uint LCType, char[] lpLCData, int cchData)\n" +
  "            => global::CalculatorApp.Uno.Win32Locale.GetLocaleInfoEx(lpLocaleName, LCType, lpLCData, cchData);");

R(k32 + "        private static extern int GetLocaleInfoEx(string lpLocaleName, uint LCType, ref int lpLCData, int cchData);",
  "        private static int GetLocaleInfoEx(string lpLocaleName, uint LCType, ref int lpLCData, int cchData)\n" +
  "            => global::CalculatorApp.Uno.Win32Locale.GetLocaleInfoEx(lpLocaleName, LCType, ref lpLCData, cchData);");

R(k32 +
  "        private static extern uint FormatMessageW(\n" +
  "            uint dwFlags,\n" +
  "            [MarshalAs(UnmanagedType.LPWStr)] string lpSource,\n" +
  "            uint dwMessageId,\n" +
  "            uint dwLanguageId,\n" +
  "            [Out] char[] lpBuffer,\n" +
  "            uint nSize,\n" +
  "            IntPtr arguments);",
  shimNote +
  "        private static uint FormatMessageW(\n" +
  "            uint dwFlags,\n" +
  "            string lpSource,\n" +
  "            uint dwMessageId,\n" +
  "            uint dwLanguageId,\n" +
  "            char[] lpBuffer,\n" +
  "            uint nSize,\n" +
  "            IntPtr arguments)\n" +
  "            => global::CalculatorApp.Uno.Win32Locale.FormatMessageW(dwFlags, lpSource, dwMessageId, dwLanguageId, lpBuffer, nSize, arguments);");

// ---- regexes ----------------------------------------------------------------------
const string sentinel = "__UNO_COLOR_SENTINEL__";
var colorSingular = new Regex(@"Windows\.UI\.Color(?![s\w])");
// Unqualified Colors.X resolves to an inaccessible Windows.UI.Colors on Uno.
var bareColors = new Regex(@"(?<![\w.])Colors\.");
// Upstream builds Calculator.ViewModels as its own assembly, where the namespace
// CalculatorApp.Utils does not exist, so a bare `Utils.` binds to the using-imported
// CalculatorApp.ViewModel.Common.Utils. Ingesting into ONE assembly brings the app-side
// CalculatorApp.Utils NAMESPACE into scope, and enclosing-namespace lookup beats
// using-directives, so `Utils.` silently rebinds and fails. Qualify it in ViewModels only.
var vmUtils = new Regex(@"(?<![\w.])Utils\.");
var xamlRoot = new Regex(@"^<\s*([A-Za-z_][\w.]*)");
// Uno Workaround #24294 - another XAML file cannot set inherited DPs on a control whose
// code-behind omits the base class. Upstream omits it everywhere; inject from the paired
// .xaml root element.
var classDecl = new Regex(
    @"^(?<i>[ \t]*)(?<mods>(?:public|internal)\s+(?:sealed\s+)?partial\s+class\s+)" +
    @"(?<name>[A-Za-z_]\w*)(?<bases>\s*:\s*[^\r\n{]+)?[ \t]*$", RegexOptions.Multiline);

var rootNs = new Dictionary<string, string>
{
    { "Application",        "Microsoft.UI.Xaml.Application" },
    { "ResourceDictionary", "Microsoft.UI.Xaml.ResourceDictionary" },
    { "Window",             "Microsoft.UI.Xaml.Window" },
};
var controlBases = new[] { "UserControl", "Page", "Control", "Application", "ResourceDictionary", "Window" };

int written = 0;

foreach (var item in Sources)
{
    var source = item.GetMetadata("FullPath");
    // Mirror upstream's own layout under the ingest root.
    var relative = source.StartsWith(UpstreamRoot, StringComparison.OrdinalIgnoreCase)
        ? source.Substring(UpstreamRoot.Length)
        : Path.GetFileName(source);

    // Normalise to LF so the multi-line rules match regardless of checkout line endings.
    var text = File.ReadAllText(source).Replace("\r\n", "\n");

    text = colorSingular.Replace(text, sentinel);
    foreach (var rule in rules) { text = text.Replace(rule.Key, rule.Value); }
    text = text.Replace(sentinel, "Windows.UI.Color");
    text = bareColors.Replace(text, "Microsoft.UI.Colors.");

    var posix = source.Replace('\\', '/');
    if (posix.IndexOf("Calculator.ViewModels", StringComparison.Ordinal) >= 0)
    {
        text = vmUtils.Replace(text, "global::CalculatorApp.ViewModel.Common.Utils.");
    }

    if (posix.EndsWith(".xaml.cs", StringComparison.OrdinalIgnoreCase))
    {
        var xamlName = Path.GetFileName(posix.Substring(0, posix.Length - 3));
        var paired = Directory.Exists(UpstreamXamlDir)
            ? Directory.GetFiles(UpstreamXamlDir, xamlName, SearchOption.AllDirectories).FirstOrDefault()
            : null;
        if (paired != null)
        {
            string root = null;
            foreach (var raw in File.ReadAllLines(paired))
            {
                var line = raw.Trim();
                if (line.Length == 0 || line.StartsWith("<!--") || line.StartsWith("<?")) { continue; }
                var m = xamlRoot.Match(line);
                if (m.Success) { root = m.Groups[1].Value.Split(':').Last(); }
                break;
            }
            if (root != null)
            {
                string ns;
                if (!rootNs.TryGetValue(root, out ns)) { ns = "Microsoft.UI.Xaml.Controls." + root; }
                var full = "global::" + ns;
                text = classDecl.Replace(text, m =>
                {
                    var bases = m.Groups["bases"].Success ? m.Groups["bases"].Value.Trim() : "";
                    var head = m.Groups["i"].Value + m.Groups["mods"].Value + m.Groups["name"].Value;
                    if (bases.Length > 0)
                    {
                        var existing = bases.TrimStart(':').Trim();
                        if (controlBases.Any(b => existing.IndexOf(b, StringComparison.Ordinal) >= 0))
                        {
                            return m.Value;   // already names a control base
                        }
                        return head + " : " + full + ", " + existing;
                    }
                    return head + " : " + full;
                });
            }
        }
    }

    var destination = Path.Combine(OutputPath, relative);
    Directory.CreateDirectory(Path.GetDirectoryName(destination));
    // Only write when changed, so incremental builds stay incremental.
    if (!File.Exists(destination) || File.ReadAllText(destination) != text)
    {
        File.WriteAllText(destination, text);
    }
    written++;
}

RewrittenCount = written;
Log.LogMessage(MessageImportance.Normal, "UnoIngest: rewrote {0} upstream source(s) into {1}", written, OutputPath);

      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Runs before the XAML generator, which needs the ingested types to resolve
       x:Class partials. The task itself skips unchanged files, so this stays cheap. -->
  <Target Name="UnoIngestSources" BeforeTargets="BeforeCompile;CoreCompile;UnoXamlGenerator">
    <UnoIngest Sources="@(UnoIngestSource)"
               UpstreamRoot="$(UpstreamRoot)"
               UpstreamXamlDir="$(UpstreamXamlRoot)"
               OutputPath="$(UnoIngestOutputPath)" />

    <!-- Added HERE, not in a static ItemGroup: MSBuild evaluates item globs before any
         target runs, so on a clean tree obj/ingest is still empty and a static glob
         matches nothing. Adding them inside the target - before CoreCompile, and so
         before the XAML source generator - makes a one-pass clean build work. -->
    <ItemGroup>
      <!-- Only files the task wrote: tooling has been seen dropping SDK AssemblyAttributes files in here. -->
      <Compile Include="$(UnoIngestOutputPath)**\*.cs" Exclude="$(UnoIngestOutputPath)**\*AssemblyAttributes.cs" />
    </ItemGroup>
  </Target>

</Project>
