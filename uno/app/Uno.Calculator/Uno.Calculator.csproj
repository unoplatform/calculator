<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native callbacks are taken as function pointers to [UnmanagedCallersOnly] statics. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationTitle>Calculator</ApplicationTitle>
    <ApplicationId>uno.platform.calculator</ApplicationId>
    <ApplicationPublisher>Uno Platform</ApplicationPublisher>
    <Description>Windows Calculator on Uno Platform.</Description>
    <!-- Upstream stamps its version in CI (11.<yymm>.<build>); mirror the current minor. -->
    <ApplicationDisplayVersion>11.2607.0</ApplicationDisplayVersion>


    <UnoFeatures>
      SkiaRenderer;
      Mvvm;
    </UnoFeatures>

    <!--
      THE TWO ROOTS. Everything under $(UpstreamRoot) is upstream's and is never copied,
      never edited - only referenced. Everything fork-owned lives under uno/.
    -->
    <UpstreamRoot>$(MSBuildThisFileDirectory)..\..\..\src\</UpstreamRoot>
    <UpstreamXamlRoot>$(UpstreamRoot)Calculator\</UpstreamXamlRoot>
    <ForkRoot>$(MSBuildThisFileDirectory)..\..\</ForkRoot>
    <UnoIngestOutputPath>$(MSBuildThisFileDirectory)obj\ingest\</UnoIngestOutputPath>
  </PropertyGroup>

  <Import Project="$(ForkRoot)build\ingest\Uno.Ingest.targets" />

  <ItemGroup>
    <!--
      Upstream C#, rewritten into obj/ingest by the UnoIngest task. The glob mirrors
      upstream's own <Compile Include="**\*.cs" />, so a file added upstream is picked
      up with no action from us.
    -->
    <UnoIngestSource Include="$(UpstreamRoot)Calculator\**\*.cs;$(UpstreamRoot)Calculator.ViewModels\**\*.cs"
                     Exclude="$(UpstreamRoot)Calculator\App.xaml.cs" />
    <UnoIngestSource Include="$(UpstreamRoot)Calculator\App.xaml.cs" />
    <!-- Upstream ships its own assembly attributes; the SDK generates them too. -->
    <UnoIngestSource Remove="$(UpstreamRoot)**\Properties\AssemblyInfo.cs" />

    <!-- Fork-owned: the interop seam, the graphing stub, and the compat adapters. -->
    <Compile Include="$(ForkRoot)interop\**\*.cs" />
    <Compile Include="$(ForkRoot)adapters\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream XAML, linked in place. Never copied, never rewritten - which is what
         keeps its 426 markup keys and the .resw keys in lockstep across 60 locales. -->
    <Page Include="$(UpstreamXamlRoot)**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="$(ForkRoot)forked\**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="$(ForkRoot)adapters\**\*.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- App.xaml is the ApplicationDefinition, so it must not also be a Page.
         NOTE: a Remove must FOLLOW its Include - MSBuild evaluates items in order. -->
    <Page Remove="$(UpstreamXamlRoot)App.xaml" />
    <Page Remove="$(ForkRoot)forked\App.xaml" />

    <!--
      Fork-owned view overrides. Each is upstream's file with one workaround applied, so
      the upstream original is removed and the forked copy wins. Delete each as its Uno
      fix lands - the cap is 5, enforced by uno/ci/purity-gate.sh.
        App.xaml                  #24301 (BrushTransition drops Opacity) + #24302 (backdrop)
        MainPage.xaml             #24302 (BackdropMaterial applies a transparent brush)
        EquationInputArea         #24301
        EquationStylePanelControl #24295 (x:Bind cast argument emits an invalid cast)
        Settings                  (unfiled) null ChildrenTransitions initializer + popup Foreground theme; #24299 icon
    -->
    <Page Remove="$(UpstreamXamlRoot)Views\MainPage.xaml" />
    <Page Remove="$(UpstreamXamlRoot)Views\GraphingCalculator\EquationInputArea.xaml" />
    <Page Remove="$(UpstreamXamlRoot)Views\GraphingCalculator\EquationStylePanelControl.xaml" />
    <Page Remove="$(UpstreamXamlRoot)Views\Settings.xaml" />

    <ApplicationDefinition Include="$(ForkRoot)forked\App.xaml" Link="App.xaml" />

    <!-- Upstream resources and assets, referenced in place. -->
    <PRIResource Include="$(UpstreamXamlRoot)Resources\**\*.resw"
                 Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Launcher/window icon and splash, generated by Uno.Resizetizer from upstream's app-list art. -->
    <UnoIcon Include="$(UpstreamXamlRoot)Assets\CalculatorAppList.targetsize-256.png" Link="icon.png" Color="#0F6CBD" />
    <!-- Resizetizer ignores Link for splash sources and rejects upstream's qualified file name, so a renamed copy is staged into obj. -->
    <UnoSplashScreen Include="$(MSBuildProjectDirectory)\obj\splash\splash_screen.png" BaseSize="128,128" Color="#202020" />

    <Content Include="$(UpstreamXamlRoot)Assets\**\*.*"
             Exclude="$(UpstreamXamlRoot)Assets\CalculatorAppList.targetsize-32.png"
             Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Uno Workaround #24299 - TitleBar.xaml asks for the unqualified name, which upstream only ships qualified. -->
    <Content Include="$(UpstreamXamlRoot)Assets\CalculatorAppList.targetsize-32.png" Link="Assets\CalculatorAppList.png" />
  </ItemGroup>

  <!--
    The native engine, statically linked into the wasm module, so DllImport("CalcManager")
    resolves against symbols in the module itself. NativeFileReference is the .NET WebAssembly
    SDK's item - Uno.Wasm.Bootstrap's WasmShellNativeFileReference is not read by the SDK link
    step that actually runs here. Build the archive with uno/native/build-wasm.sh.

    The path keeps the bootstrapper's <emscripten version>/<runtime features> layout so the
    archive stays selectable if that pipeline is ever used again.
  -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browserwasm'">
    <NativeFileReference Include="$(ForkRoot)native/bin/wasm/CalcManager.a/**/CalcManager.a" />
  </ItemGroup>

  <!-- Android loads the engine as libCalcManager.so per ABI. Build it with uno/native/build-android.sh. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
    <AndroidNativeLibrary Include="$(ForkRoot)native/bin/android/arm64-v8a/libCalcManager.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(ForkRoot)native/bin/android/x86_64/libCalcManager.so" Abi="x86_64" />
  </ItemGroup>

  <!-- Desktop loads the engine as a plain DLL next to the app. Build it with uno/native/build-win32.bat. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'desktop'">
    <None Include="$(ForkRoot)native/bin/win32/CalcManager.dll"
          Link="CalcManager.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageSplashSource" BeforeTargets="GenerateUnoSplashScreens;UnoResizetizeImages">
    <Copy SourceFiles="$(UpstreamXamlRoot)Assets\CalculatorAppList.targetsize-256_altform-unplated.png"
          DestinationFiles="$(MSBuildProjectDirectory)\obj\splash\splash_screen.png"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
